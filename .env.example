# =============================================================================
# aircraft_alert — environment configuration template
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Monitoring location
# ----------------------------------------------------------------------------
# Postcode to monitor. A positional command-line postcode takes precedence.
POSTCODE=

# Monitoring radius in kilometres. The --radius command-line option takes precedence.
# (default: 15)
RADIUS_KM=20


# ----------------------------------------------------------------------------
# ADS-B aggregators
# -----------------------------------------------------------------------------
# Enable or disable each aggregator independently.
# Accepted values: true, false, yes, no, 1, 0 (case-insensitive)
# Omitting a variable uses the default shown below.
#
# These are community-run, free services. If you find them useful, consider
# becoming a feeder yourself and contributing data back to the network.
#
# adsb.fi      — ADSBExchange v2 compatible, radius in nautical miles
#                Become a feeder: https://adsb.fi/
#                (default: true)
AGGREGATOR_ADSBFI_ENABLED=true

# adsb.lol     — ADSBExchange v2 compatible, radius in nautical miles
#                Become a feeder: https://adsb.lol/
#                (default: false)
AGGREGATOR_ADSBLOL_ENABLED=false

# adsb.one     — ADSBExchange v2 compatible, radius in nautical miles
#                Become a feeder: https://adsb.one/
#                (default: false)
AGGREGATOR_ADSBONE_ENABLED=false

# airplanes.live — ADSBExchange v2 compatible, radius in kilometres
#                  Become a feeder: https://airplanes.live/join/
#                  (default: false)
AGGREGATOR_AIRPLANESLIVE_ENABLED=false


# -----------------------------------------------------------------------------
# Aircraft type code filters
# -----------------------------------------------------------------------------
# Comma-separated ICAO type codes.
# ICAO type code reference: https://www.icao.int/publications/doc8643/pages/search.aspx

# EXCLUDE: suppress alerts for these type codes.
# Favourites always override EXCLUDE — a favourite is never suppressed.
# Example: EXCLUDE_TYPE_CODES=ULAC,P28A,C172
EXCLUDE_TYPE_CODES=

# INCLUDE: always alert for these type codes regardless of military status.
# Useful for historic/warbird aircraft that won't have dbFlags set.
# Example: INCLUDE_TYPE_CODES=SPIT,HURI,P51,T6
INCLUDE_TYPE_CODES=

# -----------------------------------------------------------------------------
# Notifications (Apprise)
# -----------------------------------------------------------------------------
# One or more Apprise-compatible URLs, comma-separated.
# Apprise supports 80+ services — full list at https://github.com/caronc/apprise/wiki
#
# Examples:
#   Pushover:  pover://USERKEY@TOKEN
#   Telegram:  tgram://BOTTOKEN/CHATID
#   Slack:     slack://TOKENB/TOKENC/TOKEND
#   Email:     mailto://user:password@gmail.com
#   Discord:   discord://WEBHOOKID/WEBHOOKTOKEN
#   ntfy:      ntfy://TOPIC
#
# Multiple services (comma-separated):
#   APPRISE_URLS=pover://USERKEY@TOKEN,tgram://BOTTOKEN/CHATID
#
APPRISE_URLS=pover://USERKEY@TOKEN


# -----------------------------------------------------------------------------
# Tracking / alert link
# -----------------------------------------------------------------------------
# The base URL used in alert notification links.
# The aircraft ICAO hex will be appended as: ?icao=XXXXXX
#
# Options:
#   https://globe.adsb.fi/   
#   https://adsb.lol/               
#   https://globe.adsbexchange.com/
#
TRACKING_URL=https://globe.adsb.fi/


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Directory for log files (aircraft.log) and alert data (alerts.csv).
# Both aircraft_alert.py and the web portal should point to the same path.
# Can be absolute (/data/logs) or relative to the script's working directory.
# (default: logs)
LOG_DIR=/data/logs


# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
# Root directory for aircraft metadata and image caches.
# Can be absolute (/data/cache) or relative to the script's working directory.
# (default: cache)
CACHE_DIR=/data/cache


# -----------------------------------------------------------------------------
# Favourites
# -----------------------------------------------------------------------------
# File containing favourite callsigns or ICAO identifiers to monitor.
# Can be absolute (/data/favourites.txt) or relative to the script's working directory.
# (default: data/favourites.txt)
FAVOURITES_FILE=/data/favourites.txt